{"nodes": [{"id": "plan_record_punch_effects_plan", "label": "Plan: record punch-in FX into the loop", "file_type": "document", "source_file": "PLAN-record-punch-effects.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_record_punch_effects_fx_automation_lane", "label": "Per-section FX automation lane", "file_type": "rationale", "source_file": "PLAN-record-punch-effects.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One effect per 1/16 cell latched by filling cells; ISR-friendly integer indexing, no run-time allocation; replays by driving punch.req."}, {"id": "plan_record_punch_effects_fxa_cell_sentinels", "label": "FXA_EMPTY / FXA_CLEAR cell sentinels", "file_type": "concept", "source_file": "PLAN-record-punch-effects.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EMPTY (0xFE) left untouched on overdub; CLEAR (0xFF) overwrites prior effects so flush erases."}, {"id": "plan_record_punch_effects_flush_gesture", "label": "Flush gesture (FX held + REC)", "file_type": "rationale", "source_file": "PLAN-record-punch-effects.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gesture + lane sentinel rather than a 28th tile, avoiding key/fx tables, tile grid and keys_lit that assume 27 keys."}, {"id": "plan_record_punch_effects_loop_basis_whole_section", "label": "Loop basis: whole section, cap FXA_MAX=64", "file_type": "rationale", "source_file": "PLAN-record-punch-effects.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cell = (clk_beat % loop_beats)*4 + clk_pos/(BEAT_U/4); clk_beat resets only on section change."}, {"id": "plan_record_punch_effects_per_section_lanes", "label": "fx_auto[4][FXA_MAX] per-section lanes in .noinit", "file_type": "concept", "source_file": "PLAN-record-punch-effects.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parallels proj_slot[4] so each section A-D carries its own automation."}, {"id": "plan_record_punch_effects_live_key_precedence", "label": "Live key precedence over lane playback", "file_type": "rationale", "source_file": "PLAN-record-punch-effects.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mirrors midi_fx convention; lane only writes punch.req when nothing live is held."}, {"id": "plan_record_punch_effects_scope_not_recorded", "label": "Throws and knob FX not recorded", "file_type": "rationale", "source_file": "PLAN-record-punch-effects.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REV/ECHO throws and DUST/DUCK are separate from punch.req; FREEZE is recorded."}, {"id": "plan_record_punch_effects_punch_req_seam", "label": "punch.req seam", "file_type": "concept", "source_file": "PLAN-record-punch-effects.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single req/cur enforces one effect at a time; the same seam midi_fx uses."}, {"id": "plan_record_punch_effects_fxa_block", "label": "fxa_block() record/playback step", "file_type": "code", "source_file": "PLAN-record-punch-effects.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_record_punch_effects_fxa_cell", "label": "fxa_cell() current cell", "file_type": "code", "source_file": "PLAN-record-punch-effects.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_record_punch_effects_fxa_len", "label": "fxa_len() lane length", "file_type": "code", "source_file": "PLAN-record-punch-effects.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_record_punch_effects_punch_live_flag", "label": "punch.live flag", "file_type": "concept", "source_file": "PLAN-record-punch-effects.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids referencing static mfx_key across translation units (punch.c is #included into fx.c)."}, {"id": "plan_record_punch_effects_punch_clear_flag", "label": "punch.clear from real button state", "file_type": "concept", "source_file": "PLAN-record-punch-effects.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use fm1_in.buttons rather than event edges for robust hold/release; guard REC-hold clear and song-page REC with !fx_held()."}, {"id": "plan_record_punch_effects_side_record_persistence", "label": "Side-record persistence of FX lanes", "file_type": "rationale", "source_file": "PLAN-record-punch-effects.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rides in bytes 64..256 of each flash copy (ST_SIDE_MAX=192), invisible to older firmware: no format bump, no touching the 3840-byte project_t wall."}, {"id": "plan_record_punch_effects_reset_on_new_load", "label": "Lane reset on NEW / load / boot", "file_type": "concept", "source_file": "PLAN-record-punch-effects.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_record_punch_effects_verification_plan", "label": "Verification plan (unit, persistence, suite, device)", "file_type": "concept", "source_file": "PLAN-record-punch-effects.md", "source_location": "L113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run run_tests.sh without piping thro