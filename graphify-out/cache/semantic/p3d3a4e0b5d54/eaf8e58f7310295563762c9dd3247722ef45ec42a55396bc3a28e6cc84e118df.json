{"nodes": [{"id": "assets_screens_sloop_2_5_screens", "label": "Sloop 2.5 Screens (UI screenshot sheet)", "file_type": "image", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six-panel showcase of the Sloop 2.5 device UI: tracks overview, PHYS and NOISE engine pages, DX7 presets, synthesised drum kit, and global drum send page. Consistent design language: top status bar (play, bpm, track badge, battery), 4-up colour-coded parameter header with mini-sliders, 2x2 large-value grid, step strip and footer 'ENGINE PRESET  PAGE n/4'."}, {"id": "assets_screens_sloop_2_5_screens_tracks_screen", "label": "TRACKS screen", "file_type": "image", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": "panel 1 (top-left)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overview of 4 colour-coded tracks (1 PLUCK BASS phys, 2 RHODES digital, 3 KOTO phys, 4 LO-FI drums) with per-track step pattern rows and level bars; 96 bpm, position 1.3; bottom knobs swing 0, level 81, steps 32, pan 0. Caption: KOTO and PLUCK BASS on PHYS."}, {"id": "assets_screens_sloop_2_5_screens_phys_screen", "label": "PHYS engine page", "file_type": "image", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": "panel 2 (top-middle)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Physical-modelling engine parameters MODEL (STRNG), STRC 16%, BRIT 55%, DAMP 65% on track 3; footer 'PHYS KOTO  BODY 1/4'."}, {"id": "assets_screens_sloop_2_5_screens_noise_screen", "label": "NOISE engine page", "file_type": "image", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": "panel 3 (top-right)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Noise engine preset RAIN: MODE DUST, COLR 24%, FREQ 2.3 kHz, RES 63%; footer 'NOISE RAIN  SRC 1/4'."}, {"id": "assets_screens_sloop_2_5_screens_presets_screen", "label": "PRESETS screen", "file_type": "image", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": "panel 4 (bottom-left)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preset browser for engine FM6 (No. 156/16) listing FX CHIP NOISE, U01 BRASS 1 .. U06 BELLS with U03 E.PIANO 1 selected; caption: a DX7 cartridge stored as user presets."}, {"id": "assets_screens_sloop_2_5_screens_drums_kit_syn1_screen", "label": "DRUMS: KIT SYN1 screen", "file_type": "image", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": "panel 5 (bottom-middle)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kit 43 'SYN1' on boom 808 engine with grid/kit toggle, 16-pad voice grid (kick, kick2, snare, clap, hat, open, pedal, rim, snr 2, tom l, tom h, crash, ride, shake, conga, bell) and knobs kit 43, level 78, reverb 12, pan 0; caption: your own synthesised kit, with its name."}, {"id": "assets_screens_sloop_2_5_screens_glo_drums_screen", "label": "GLO -> DRUMS page", "file_type": "image", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": "panel 6 (bottom-right)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global page for the drums: CH 10 (MIDI channel), LVL 100, REV 16, DLY 64 on track 1; footer 'PHYS PLUCK BASS  DRUMS 4/4'; caption: DLY is the drums' delay send."}, {"id": "assets_screens_sloop_2_5_screens_phys_engine", "label": "PHYS physical-modelling engine", "file_type": "concept", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_sloop_2_5_screens_noise_engine", "label": "NOISE engine", "file_type": "concept", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_sloop_2_5_screens_fm6_engine", "label": "FM6 engine", "file_type": "concept", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_sloop_2_5_screens_dx7_cartridge_user_presets", "label": "DX7 cartridge as user presets", "file_type": "concept", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_sloop_2_5_screens_synthesised_drum_kit", "label": "Synthesised drum kit (boom 808)", "file_type": "concept", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_sloop_2_5_screens_drum_send_effects", "label": "Drum reverb/delay sends", "file_type": "concept", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_sloop_2_5_screens_engine_page_layout", "label": "Engine page layout pattern (4-param header + 2x2 grid + paged footer)", "file_type": "rationale", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each parameter is colour-coded (blue, green, yellow, orange) consistently across header slider, large value and knob, mapping to four hardware encoders; footer shows engine, preset and page index n/4."}, {"id": "assets_screens_sloop_2_5_screens_track_colour_coding", "label": "Per-track colour coding", "file_type": "rationale", "source_file": "assets/screens/sloop-2.5-screens.png", "source_location": null, "source_url"