{"nodes": [{"id": "assets_screens_live_tracks", "label": "Live Tracks Screen (screenshot)", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "480x480 square device UI showing all four tracks at once for live performance: compact header, four colour-coded track rows each with a 16-step pattern and level meter, and a bottom row of four encoder-mapped parameters."}, {"id": "assets_screens_live_tracks_header_bar", "label": "Header Bar (BPM / Transport / Record)", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large '101 bpm' tempo readout, play icon with bar.beat position '1.1', four-dot beat/bar indicator (first lit red), and global red 'rec' label plus red record dot indicating recording is active."}, {"id": "assets_screens_live_tracks_tempo_bpm_display", "label": "Tempo BPM Display", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_live_tracks_transport_position", "label": "Transport Play State and Position (1.1)", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_live_tracks_global_record_indicator", "label": "Global Record Indicator", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_live_tracks_track_row", "label": "Track Row Layout", "file_type": "concept", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each row: numbered colour tile on the left, track name plus engine type label, 16-step pattern strip with playhead marker underneath, and a horizontal level bar on the right. The selected track (2) has a filled bright tile and highlighted text."}, {"id": "assets_screens_live_tracks_track_1_808_boom_analog", "label": "Track 1: 808 BOOM (analog, blue)", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_live_tracks_track_2_rhodes_digital", "label": "Track 2: RHODES (digital, green, selected, rec-armed)", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_live_tracks_track_3_lofi_flute_sample", "label": "Track 3: LOFI FLUTE (sample, yellow/olive)", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_live_tracks_track_4_808_drums", "label": "Track 4: 808 drums (drums, orange)", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_live_tracks_track_engine_types", "label": "Track Engine Types (analog / digital / sample / drums)", "file_type": "concept", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine type is shown as a dimmer suffix next to the track name, so each track's sound source (analog synth, digital synth, sampler, drum machine) is visible at a glance."}, {"id": "assets_screens_live_tracks_step_pattern_strip", "label": "16-Step Pattern Strip", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active steps lit in the track colour, inactive steps dark grey; track 4 (drums) shows all 16 steps filled, track 3 shows none."}, {"id": "assets_screens_live_tracks_playhead_marker", "label": "Playhead Marker", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "White underline below step 5 on every row, showing the shared current step position across all tracks."}, {"id": "assets_screens_live_tracks_track_level_meter", "label": "Per-Track Level Bar", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_live_tracks_track_rec_badge", "label": "Per-Track Rec Arm Badge", "file_type": "image", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Red 'rec' badge replaces part of the row on track 2, marking it as the record-armed track while the global recorder is running."}, {"id": "assets_screens_live_tracks_track_color_coding", "label": "Per-Track Colour Coding", "file_type": "rationale", "source_file": "assets/screens/live-tracks.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each track gets a fixed colour (blue, green, olive, orange) reused for its number tile, step LEDs, and the matching encoder knob ring, tying on-screen parameters to tracks visually."}, {"id": "assets_screens_live_tracks_encoder_parameter_row", "label": "Encoder Parameter Row", "file_type": "image", "source_