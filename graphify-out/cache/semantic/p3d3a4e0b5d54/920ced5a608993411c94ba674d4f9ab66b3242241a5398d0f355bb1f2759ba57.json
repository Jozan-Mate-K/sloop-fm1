{"nodes": [{"id": "assets_screens_editor_chop", "label": "Editor Chop Screenshot", "file_type": "image", "source_file": "assets/screens/editor-chop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_editor_chop_chop_editor_panel", "label": "CHOP Editor Panel", "file_type": "concept", "source_file": "assets/screens/editor-chop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web editor section that slices a long sample (e.g. LONG20S, 20.00 s) into chops, shown as a dark high-contrast monochrome UI with a header summary of sound name, duration, chop count and kept count."}, {"id": "assets_screens_editor_chop_open_a_sound", "label": "Open a Sound (load sample)", "file_type": "concept", "source_file": "assets/screens/editor-chop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_editor_chop_chop_waveform_strip", "label": "Chop Waveform Strip", "file_type": "concept", "source_file": "assets/screens/editor-chop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Horizontal waveform split into numbered columns at chop markers; selected chop highlighted in grey; unkept chops labelled with an em dash instead of a note."}, {"id": "assets_screens_editor_chop_chop_note_mapping", "label": "Chop-to-Note Chromatic Mapping", "file_type": "rationale", "source_file": "assets/screens/editor-chop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept chops are assigned consecutive chromatic notes starting at C4 (C4, C#4, D4, D#4...), skipping unkept chops, so each kept slice is playable from a key."}, {"id": "assets_screens_editor_chop_keep_selection", "label": "Chop Keep/Untick Selection", "file_type": "rationale", "source_file": "assets/screens/editor-chop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-chop checkboxes plus Keep all / Keep none; unticked chops go neither to the slot nor to the exported WAVs, letting a long recording be reduced to only the useful hits (16 chops, 8 kept)."}, {"id": "assets_screens_editor_chop_fit_to_slot", "label": "Fit to Slot", "file_type": "concept", "source_file": "assets/screens/editor-chop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Button (shown disabled/greyed) to trim kept chops so the result fits the device sample slot capacity."}, {"id": "assets_screens_editor_chop_chop_length_trim", "label": "Per-Chop Length Trim", "file_type": "concept", "source_file": "assets/screens/editor-chop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selected-chop detail row (Chop 2 C#4) with keep toggle, length slider (0.92 s of 1.25 s), play preview and 'Up to the next marker' to extend length to the following chop marker."}, {"id": "assets_screens_editor_chop_send_to_usr_slot", "label": "Send to USR1/USR2/USR3 Slots", "file_type": "concept", "source_file": "assets/screens/editor-chop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uploads the kept chops as a user sample kit into one of three user slots on the device."}, {"id": "assets_screens_editor_chop_download_wavs", "label": "Download WAVs Export", "file_type": "concept", "source_file": "assets/screens/editor-chop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "assets_screens_editor_chop", "target": "assets_screens_editor_chop_chop_editor_panel", "relation": "references", "confidence": "EXTRACTED", "confide