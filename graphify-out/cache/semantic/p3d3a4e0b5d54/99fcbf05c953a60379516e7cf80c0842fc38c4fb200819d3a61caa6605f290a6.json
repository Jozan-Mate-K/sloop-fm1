{"nodes": [{"id": "assets_screens_editor_drums", "label": "Drum Sequencer Editor Screenshot", "file_type": "image", "source_file": "assets/screens/editor-drums.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web UI screenshot of the Sequencer tab with Track 4 (Drums) selected: pattern controls on top, kit/level/roll toolbar, and a 16-row x 16-step drum grid. Monochrome, dense, hardware-like layout."}, {"id": "assets_screens_editor_drums_sequencer_tab", "label": "Sequencer Tab (Web UI)", "file_type": "concept", "source_file": "assets/screens/editor-drums.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One of the top-level tabs: Sound, Sequencer, Tracks, Library, Samples, Projects, Settings."}, {"id": "assets_screens_editor_drums_track_selector", "label": "Track Selector (1, 2, 3, 4 Drums)", "file_type": "concept", "source_file": "assets/screens/editor-drums.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four tracks; track 4 is a dedicated drum track with a different step editor than melodic tracks 1-3."}, {"id": "assets_screens_editor_drums_seq_pattern_params", "label": "SEQ Pattern Parameters (LEN, DIV, SWG, GATE)", "file_type": "concept", "source_file": "assets/screens/editor-drums.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-pattern length (16 steps), clock division (1/16), swing (50%) and gate length (50%)."}, {"id": "assets_screens_editor_drums_drum_step_grid", "label": "Drum Step Grid (16 voices x 16 steps)", "file_type": "concept", "source_file": "assets/screens/editor-drums.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows map to the 16 drum sounds on white keys F3..G5 (KICK, KICK