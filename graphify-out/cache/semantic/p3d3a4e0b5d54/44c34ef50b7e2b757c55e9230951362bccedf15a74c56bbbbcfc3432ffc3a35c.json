{"nodes": [{"id": "assets_screens_editor_cartridge", "label": "Editor Cartridge Screen (screenshot)", "file_type": "image", "source_file": "assets/screens/editor-cartridge.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "UI screenshot of the FM-1 web editor cartridge panel: sysex import/export toolbar, a 32-voice grid of a loaded .syx cartridge with checkboxes mapping ticked voices to bank slots B1..B27, a user-presets option and a 'store cartridge in bank' action."}, {"id": "assets_screens_editor_cartridge_sysex_toolbar", "label": "SysEx Import/Export Toolbar", "file_type": "concept", "source_file": "assets/screens/editor-cartridge.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Buttons: import sysex, export sysex, export bank as sysex, init voice; plus drag-and-drop of a .syx file onto the panel."}, {"id": "assets_screens_editor_cartridge_syx_drop_import", "label": "Drop .syx File onto Panel", "file_type": "concept", "source_file": "assets/screens/editor-cartridge.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_editor_cartridge_init_voice", "label": "Init Voice", "file_type": "concept", "source_file": "assets/screens/editor-cartridge.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_screens_editor_cartridge_cartridge_voice_grid", "label": "Cartridge Voice Grid (32 voices)", "file_type": "concept", "source_file": "assets/screens/editor-cartridge.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "5-column grid of the 32 voices of a DX7-style cartridge (BRASS 1, STRINGS 1, E.PIANO 1 ... SYN BASS). Clicking a name opens it for editing; a checkbox selects it for storing to the bank.", "rat